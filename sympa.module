<?php

/**
 * @file
 * Sympa module.
 */

use Drupal\file\Entity\File;
use Drupal\Core\Link;
use Drupal\Core\Url;
use Drupal\Component\Utility\Xss;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Render\Markup;
use Drupal\image\Entity\ImageStyle;
use Drupal\Component\Utility\Html;

/**
 * Implements hook_theme().
 */
function sympa_theme($existing, $type, $theme, $path) {
  return [
    'sympa_email' => [
      'variables' => [
        'type' => NULL,
        'title' => NULL,
        'hero_image' => NULL,
        'body' => NULL,
        'view_link' => NULL,
        'site_name' => NULL,
        'unsubscribe' => NULL,
        'learn' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function sympa_mail($key, &$message, $params) {
  switch ($key) {
    case 'node-update':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['headers'] = [
        'From' => $message['from'],
        'Reply-To' => 'no-reply@colorado.edu',
        'Content-Type' => 'text/html; charset=UTF-8',
      ] + $message['headers'];
      $message['subject'] = $params['title'];
      $message['body'][] = $params['body'];
      break;
  }
}

/**
 * Implements hook_entity_presave().
 */
function sympa_entity_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'node') {
    return;
  }
  $type = $entity->bundle();
  if ($type !== 'news' && $type !== 'service_alert') {
    return;
  }
  if ($entity->hasField('field_sympa_send') && (bool) $entity->get('field_sympa_send')->value) {
    $entity->set('field_sympa_send', 0);
    $entity->sympaSendPending = TRUE;
  }
}

/**
 * Implements hook_node_insert().
 */
function sympa_node_insert(EntityInterface $entity) {
  if (!empty($entity->sympaSendPending)) {
    sympa_node_email_send($entity);
  }
}

/**
 * Implements hook_node_update().
 */
function sympa_node_update(EntityInterface $entity) {
  if (!empty($entity->sympaSendPending)) {
    sympa_node_email_send($entity);
  }
}

/**
 * Sends a Sympa email for a node if the send flag was set.
 */
function sympa_node_email_send($entity) {
  if (!$entity->isPublished()) {
    \Drupal::logger('sympa')->notice(
      'Sympa email skipped for unpublished node @nid.',
      ['@nid' => $entity->id()]
    );
    \Drupal::messenger()->addWarning(t(
      'Sympa Send was checked but this node is unpublished, so no email was sent. Re-check Sympa Send when you publish.'
    ));
    return;
  }

  $type = $entity->bundle();
  $img_tag = '';

  $body_value = $entity->get('body')->value ?? '';
  if ($body_value !== '') {
    $body_value = Html::transformRootRelativeUrlsToAbsolute(
      $body_value,
      \Drupal::request()->getSchemeAndHttpHost()
    );
  }
  $sympa_nid = $entity->id();

  if ($type == 'service_alert') {
    $status = $entity->get('field_service_alert_status')->value ?? '';
    $sympa_title = ($status !== '' ? $status . ': ' : '') . $entity->getTitle();
  }
  else {
    $sympa_title = $entity->getTitle();
    $style = ImageStyle::load('fn_large');
    if (!$entity->get('field_media_hero_image')->isEmpty()) {
      $media_id = $entity->get('field_media_hero_image')->target_id;
      $media = \Drupal::entityTypeManager()->getStorage('media')->load($media_id);
      if ($media && !$media->get('field_media_image_2')->isEmpty()) {
        $image_field = $media->get('field_media_image_2');
        $file_id = $image_field->target_id;
        $alt = $image_field->alt ?? '';
        $file = File::load($file_id);
        if ($file && $style) {
          $url = $style->buildUrl($file->getFileUri());
          if ($url) {
            $img_tag = '<img src="' . Html::escape($url) . '" alt="' . Html::escape($alt) . '" style="max-width:100%;height:auto;" /><br /><br />';
          }
        }
      }
    }
  }
  sympa_build_email($type, $sympa_nid, $sympa_title, $body_value, $img_tag);
}

/**
 * Build Sympa Email.
 */
function sympa_build_email(string $type, int $sympa_nid, string $sympa_title, string $body, string $img_tag): void {
  $options = ['absolute' => TRUE];
  $here = Url::fromRoute('entity.node.canonical', ['node' => $sympa_nid], $options);
  $more_info = Url::fromRoute('entity.node.canonical', ['node' => 2514], $options);
  $un_options = ['absolute' => TRUE, 'fragment' => 'unsubscribe'];
  $unsubscribe_n = Url::fromRoute('entity.node.canonical', ['node' => 31540], $un_options);
  $unsubscribe_sa = Url::fromRoute('entity.node.canonical', ['node' => 31539], $un_options);
  $config = \Drupal::config('system.site');
  $body_xss = $body !== '' ? Xss::filterAdmin($body) : NULL;
  $body_stripped = $body_xss ? preg_replace("/<img[^>]+\>/i", " ", $body_xss) : '';
  $hero_image = $img_tag ? $img_tag : '';
  $renderer = \Drupal::service('renderer');
  $build = [
    '#theme' => 'sympa_email',
    '#type' => $type,
    '#title' => $type === 'service_alert' ? $sympa_title : NULL,
    '#hero_image' => Markup::create($hero_image),
    '#body' => Markup::create($body_stripped),
    '#view_link' => Link::fromTextAndUrl(
      $type === 'service_alert'
        ? t('View full service alert here')
        : t('View news story here'),
      $here
    )->toString(),
    '#site_name' => $config->get('name'),
    '#unsubscribe' => Link::fromTextAndUrl(
      t('Unsubscribe now'),
      $type === 'service_alert' ? $unsubscribe_sa : $unsubscribe_n
    )->toString(),
    '#learn' => Link::fromTextAndUrl(t('Learn more about these alerts'), $more_info)->toString(),
  ];
  $body_rendered = $renderer->renderInIsolation($build);
  $config = \Drupal::config('sympa.settings');
  if ($config->get('sympa_email_prod')) {
    $to_email = $type === 'service_alert'
      ? 'oit-service-alert@colorado.edu'
      : 'oit-news@colorado.edu';
  }
  else {
    $to_email = 'oit-web-test@colorado.edu';
  }
  $params = [];
  $params['to'] = $to_email;
  $params['body'] = $body_rendered;
  $params['title'] = $sympa_title;
  sympa_send('node-update', $params);
  \Drupal::logger('sympa')->notice('Sympa email sent to: ' . $to_email . ' regarding node: ' . $sympa_nid);
}

/**
 * Send email.
 */
function sympa_send($key, $params) {
  $to = $params['to'];
  // Symfony Mailer Lite reads these params ahead of the Content-Type header,
  // so the HTML body and plain-text alternative survive regardless of the
  // symfony_mailer_lite.message defaults.
  $params['content_type'] = 'text/html';
  $params['generate_plain'] = TRUE;
  $langcode = \Drupal::currentUser()->getPreferredLangcode();
  $send = TRUE;
  $module = 'sympa';
  $mailManager = \Drupal::service('plugin.manager.mail');
  $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, $send);
  return $result;
}
